# ==============================================================================
# ForgeAI — AI Engineering Operating System
# Canonical Environment Configuration Template (.env.example)
# ==============================================================================

# --- Environment & Deployment Mode ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- PostgreSQL Database (pgvector / multi-database) ---
POSTGRES_USER=forgeai
POSTGRES_PASSWORD=password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=postgres

# --- Redis 7 (Cache, Token Blacklist & Rate Limiting) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- Edge API Gateway (Reactive / Spring Cloud Gateway) ---
GATEWAY_PORT=8080
GATEWAY_PUBLIC_URL=http://localhost:8080

# Internal Service URIs (resolved via Docker DNS)
IDENTITY_SERVICE_URI=http://identity-service:8081
PROJECT_SERVICE_URI=http://project-service:8085
SOURCE_CONTROL_SERVICE_URI=http://source-control-service:8082
TESTING_SERVICE_URI=http://testing-service:8083
AI_SERVICE_URI=http://ai-service:8084

# --- Security & JWT / JWKS ---
JWT_ISSUER=forgeai-identity
JWT_EXPIRATION_SECONDS=900
JWT_REFRESH_EXPIRATION_SECONDS=604800

# --- GitHub App & Webhook Ingestion ---
GITHUB_APP_ID=1001
GITHUB_CLIENT_ID=dev-github-client-id
GITHUB_CLIENT_SECRET=dev-github-client-secret
GITHUB_WEBHOOK_SECRET=dev-webhook-secret

# --- AI Intelligence Service & Gemini ---
GEMINI_API_KEY=mock-gemini-key-for-dev
AI_SERVICE_PORT=8084
AI_DATABASE_URL=postgresql://forgeai:password@postgres:5432/ai_db

# --- Frontend Web Dashboard (Next.js 16) ---
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080
FRONTEND_PORT=3000
