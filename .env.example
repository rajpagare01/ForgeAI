# ==============================================================================
# ForgeAI — AI Engineering Operating System
# Canonical Environment Configuration Template (.env.example)
# ==============================================================================

# --- Environment & Deployment Mode ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- PostgreSQL Database (pgvector / multi-database) ---
POSTGRES_USER=forgeai
POSTGRES_PASSWORD=your-secure-postgres-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=postgres

# --- Redis 7 (Cache, Token Blacklist & Rate Limiting) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- Edge API Gateway (Reactive / Spring Cloud Gateway) ---
GATEWAY_PORT=8080
GATEWAY_PUBLIC_URL=http://localhost:8080

# Internal Service URIs (resolved via Docker DNS)
IDENTITY_SERVICE_URI=http://identity-service:8081
PROJECT_SERVICE_URI=http://project-service:8085
SOURCE_CONTROL_SERVICE_URI=http://source-control-service:8082
TESTING_SERVICE_URI=http://testing-service:8083
AI_SERVICE_URI=http://ai-service:8084

# --- Security & JWT / JWKS ---
JWT_ISSUER=forgeai-identity
JWT_EXPIRATION_SECONDS=900
JWT_REFRESH_EXPIRATION_SECONDS=604800

# --- GitHub App & Webhook Ingestion ---
# Numeric GitHub App ID from GitHub Developer Settings
GITHUB_APP_ID=your-github-app-id
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
# Shared webhook secret configured in GitHub App settings
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret
# RSA private key in PKCS#8 PEM format (newlines encoded as \n or provide path)
GITHUB_PRIVATE_KEY=""
GITHUB_PRIVATE_KEY_PATH=/path/to/github-app-private-key.pem

# --- AI Intelligence Service (Gemini Primary + Groq Fallback) ---
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-pro
GEMINI_EMBEDDING_MODEL=models/text-embedding-004
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile
ALLOW_TEST_FALLBACK=false
AI_SERVICE_PORT=8084
AI_DATABASE_URL=postgresql://forgeai:your-secure-postgres-password@postgres:5432/ai_db

# --- Frontend Web Dashboard (Next.js 16) ---
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080
FRONTEND_PORT=3000

# --- Email Alerting (Push Commit Guard / Security Notifications) ---
# Example for Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USE_TLS=true, and use a 16-char Google App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_USE_TLS=true
ALERT_FALLBACK_EMAIL=your-email@gmail.com
